{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerce-ai-ops.local/schemas/order.schema.json",
  "title": "Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "customer_id",
    "status",
    "currency",
    "total_minor",
    "version",
    "items",
    "observed_at",
    "source"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "customer_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string" },
    "currency": { "type": "string", "const": "USD" },
    "total_minor": { "type": "integer", "minimum": 0 },
    "version": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sku_id", "quantity", "unit_price_minor", "title_snapshot"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sku_id": { "type": "string", "format": "uuid" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unit_price_minor": { "type": "integer", "minimum": 0 },
          "title_snapshot": { "type": "string" }
        }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "const": "sql" }
  }
}
