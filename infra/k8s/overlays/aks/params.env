# Provider values for AKS, all placeholders. Fill them from `terraform output` (infra/terraform/azure)
# or let .github/workflows/deploy.yml write this file from repository variables. Not secrets.
KEY_VAULT_NAME=commerceops-kv-demo
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_WORKLOAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
PUBLIC_HOST=commerce.example.com
TLS_CERT_KEYVAULT_URI=https://commerceops-kv-demo.vault.azure.net/certificates/edge-tls
DATA_SUBNETS_CIDR=10.42.16.0/23
